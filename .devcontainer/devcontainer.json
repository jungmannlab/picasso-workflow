{
  "name": "picasso-workflow",
  "build": { "dockerfile": "Dockerfile" },

  // runArgs:
  //  - NET_ADMIN / NET_RAW: the firewall (init-firewall.sh) needs these to
  //    manage iptables/ipset. Nothing else about the container is relaxed:
  //    Docker's DEFAULT seccomp filter and /proc masking stay ON, and the
  //    container is non-root (`vscode`), non-privileged, behind the
  //    default-deny egress firewall, and inside OrbStack's VM.
  //
  //  We do NOT relax seccomp/systempaths here. Those were only ever needed so
  //  Claude Code's per-command bubblewrap (bwrap) sandbox could build itself
  //  (create a user namespace + mount a fresh /proc). That nested sandbox is
  //  turned OFF for this container instead — see the managed-settings file
  //  written in the Dockerfile (/etc/claude-code/managed-settings.json). The
  //  container itself is the security boundary, so the inner sandbox is
  //  redundant, and disabling it lets us keep Docker's default hardening
  //  (which is strictly safer than seccomp=unconfined) while `bash` just runs.
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],

  "remoteUser": "vscode",

  // Reuse your host Claude auth + settings inside the container.
  // (the shared permission allowlist lives in ~/.claude; the bwrap sandbox is
  //  force-disabled by the managed-settings file baked into the image, which
  //  outranks ~/.claude and is NOT shared back to the host.)
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
    "source=/Volumes/pool-miblab1/users/hgrabmayr/picasso-workflow-examples/tests,target=/Volumes/pool-miblab1/users/hgrabmayr/picasso-workflow-examples/tests,type=bind",
    "source=/Volumes/pool-miblab1/users/hgrabmayr/picasso-workflow-examples/templates,target=/Volumes/pool-miblab1/users/hgrabmayr/picasso-workflow-examples/templates,type=bind",
  ],

  // Bring up the default-deny egress firewall every time the container starts.
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",

  // `[dev]` pulls the test/lint tooling now that it lives in an optional extra
  // (out of runtime deps). No `--pre` needed: the picassosr pin references a
  // pre-release (>=0.12.0a3), so pip allows pre-releases for that requirement
  // only and resolves 0.12.0a3 on this 3.11 base.
  //
  // black/flake8 are not package deps (pre-commit owns them), so install them
  // here at the SAME versions CI uses (.github/workflows/lint.yml, matching
  // .pre-commit-config.yaml) — otherwise a bare `black`/`flake8` in the
  // container drifts from CI and produces spurious reformat/lint diffs. Keep
  // this pin in sync with lint.yml and .pre-commit-config.yaml.
  "postCreateCommand": "pip install --user -e '.[dev]' && pip install --user black==26.5.1 flake8==7.1.1 Flake8-pyproject",

  "customizations": {
    "vscode": {
      "settings": { "task.allowAutomaticTasks": "on"},
      "extensions": ["anthropic.claude-code", "ms-python.python", "github.vscode-pull-request-github"]
    }
  }
}
