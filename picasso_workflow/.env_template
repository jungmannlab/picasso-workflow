# Confluence credentials.
#
# Non-secret connection settings (URL, Space, DefaultPage, Username) normally
# live in config.yaml's Confluence / ConfluenceTest sections; the lines below
# are optional per-machine overrides. The TOKEN, however, is only ever an
# environment variable -- set it here (this file is loaded at import via
# python-dotenv) or export it in your shell / runner environment.
#
# Operational runs (GUI / workflows):
CONFLUENCE_TOKEN=your-operational-api-token
# Test suite (pytest):
TEST_CONFLUENCE_TOKEN=your-test-api-token
# Optional non-secret test overrides (otherwise taken from config.yaml):
# TEST_CONFLUENCE_URL=https://your-confluence/wiki
# TEST_CONFLUENCE_SPACE=~yourspacekey
# TEST_CONFLUENCE_PAGE=Your Test Page
# TEST_CONFLUENCE_USERNAME=you@example.com

# Drive paths on different systems
DRIVEPATHS="
ipsju55::/Volumes/pool-miblab,/Volumes/pool-miblab4,/Volumes/pool-miblab1;
hpcl8001::/fs/mpib/pool-miblab,/fs/mpib/pool-miblab4,/fs/mpib/pool-miblab1;
ipsju00::W:,X:,V:;
"
